<Window x:Class="DownloadsStack.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DownloadsStack.Localization" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AA Desk" Style="{StaticResource {x:Type Window}}" Width="900" Height="650" MinWidth="760" MinHeight="520"
        Background="#242424" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <DrawingImage x:Key="BrandVector"><DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#202020"><GeometryDrawing.Geometry><RectangleGeometry Rect="0.7,0.7,14.6,14.6" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry><GeometryDrawing.Pen><Pen Brush="#7ED8F5" Thickness="1.1"/></GeometryDrawing.Pen></GeometryDrawing>
            <GeometryDrawing Geometry="M4.4,12.5 L8,3.5 11.6,12.5 M5.7,9.3 L10.3,9.3"><GeometryDrawing.Pen><Pen Brush="#7ED8F5" Thickness="1.45" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
        </DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#164657"/>
        <SolidColorBrush x:Key="NavNormalBrush" Color="Transparent"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#E7E7E7"/>
            <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="9,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303437"/></Trigger>
                    <Trigger Property="Tag" Value="Selected"><Setter TargetName="Surface" Property="Background" Value="{StaticResource NavSelectedBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="#247C98"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ModuleToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="43"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid Width="38" Height="22">
                    <Border x:Name="Track" BorderBrush="#70787B" BorderThickness="1" CornerRadius="11"><Border.Background><SolidColorBrush Color="#555D60"/></Border.Background></Border>
                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#1888AA"/><Setter TargetName="Track" Property="BorderBrush" Value="#55C7E8"/><Setter TargetName="Thumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="16"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="InfoGlyph" TargetType="Border">
            <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Help"/><Setter Property="Margin" Value="5,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
        </Style>
        <Style x:Key="FooterLink" TargetType="Button">
            <Setter Property="Foreground" Value="#BDBDBD"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#EDEDED"/><Setter Property="BorderBrush" Value="#666666"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10"/><Setter Property="MaxWidth" Value="230"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#8CA7B2"/><Setter Property="Margin" Value="0,17,0,8"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#282828"/><Setter Property="BorderBrush" Value="#3B3B3B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#A9A9A9"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    </Window.Resources>
    <Border BorderBrush="#414141" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
            <Border Background="#303030" BorderBrush="#3B3B3B" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <Image Source="{StaticResource BrandVector}" Width="16" Height="16" Margin="12,0,9,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="1" Text="AA Desk" VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="2" Content="×" FontSize="17" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="Done" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Settings_Close], Source={x:Static loc:Loc.Text}}"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#202020" BorderBrush="#3B3B3B" BorderThickness="0,0,1,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="#3B3B3B" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="{StaticResource BrandVector}" Width="28" Height="28" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="AA Desk" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="8,8,8,0">
                            <TextBlock Text="{Binding [Settings_Modules], Source={x:Static loc:Loc.Text}}" FontSize="10" Foreground="#8D8D8D" Margin="10,4,0,5"/>
                            <Button x:Name="GeneralNav" Style="{StaticResource NavButton}" Tag="Selected" Click="NavigateGeneral"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Stroke="#9EABB0" StrokeThickness="1.5" Data="M3.5,5.5 L16.5,5.5 M3.5,10 L16.5,10 M3.5,14.5 L16.5,14.5" Width="17" Height="17" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{Binding [Nav_General], Source={x:Static loc:Loc.Text}}" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid></Button>
                            <Button x:Name="SmartNav" Style="{StaticResource NavButton}" Click="NavigateSmart"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path StrokeThickness="1.5" Data="M2.5,5.5 L8.5,5.5 10,7.5 17.5,7.5 17.5,16 2.5,16 Z M10,9.5 L12,11.5 10,13.5 M8,11.5 L12,11.5" Width="17" Height="17" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#9EABB0"/><Style.Triggers><DataTrigger Binding="{Binding SmartExplorerEnabled}" Value="True"><Setter Property="Stroke" Value="#58C7E8"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Grid.Column="1" Text="Smart Explorer" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid></Button>
                            <Button x:Name="DownloadsNav" Style="{StaticResource NavButton}" Click="NavigateDownloads"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path StrokeThickness="1.5" Data="M10,2.5 L10,11.5 M7,8.5 L10,11.5 13,8.5 M3,12.5 L3,16.5 17,16.5 17,12.5" Width="17" Height="17" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#9EABB0"/><Style.Triggers><DataTrigger Binding="{Binding DownloadsEnabled}" Value="True"><Setter Property="Stroke" Value="#58C7E8"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Grid.Column="1" Text="{Binding [Nav_Downloads], Source={x:Static loc:Loc.Text}}" Margin="7,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></Button>
                            <Border Background="#3B3B3B" Height="1" Margin="5,12,5,9"/>
                            <TextBlock Text="{Binding [Nav_Application], Source={x:Static loc:Loc.Text}}" FontSize="10" Foreground="#8D8D8D" Margin="10,0,0,5"/>
                            <Button x:Name="AboutNav" Style="{StaticResource NavButton}" Click="NavigateAbout"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Stroke="#9EABB0" StrokeThickness="1.5" Data="M10,3 A7,7 0 1 1 9.99,3 M10,9 L10,14 M10,6 L10,7" Width="17" Height="17" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{Binding [Nav_About], Source={x:Static loc:Loc.Text}}" Margin="7,0,0,0" VerticalAlignment="Center"/></Grid></Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="30,24,30,24">
                            <StackPanel x:Name="GeneralPage">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_General], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_GeneralDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Startup], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <CheckBox x:Name="RunAtLogon" Content="{Binding [Settings_RunAtLogon], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding RunAtLogon, Mode=OneWay}" Checked="RunAtLogonChanged" Unchecked="RunAtLogonChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_RunAtLogonHint], Source={x:Static loc:Loc.Text}}" Margin="28,5,0,0"/>
                                    <TextBlock x:Name="StartupBlocked" Style="{StaticResource Hint}" Foreground="#FF99A4" Text="{Binding [Settings_RunAtLogonBlocked], Source={x:Static loc:Loc.Text}}" Visibility="{Binding AutostartBlocked, Converter={StaticResource BooleanVisibility}}" Margin="28,5,0,0"/>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Appearance], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <CheckBox x:Name="Hardware" Content="{Binding [Settings_Hardware], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding HardwareRendering, Mode=OneWay}" Checked="HardwareChanged" Unchecked="HardwareChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_HardwareHint], Source={x:Static loc:Loc.Text}}" Margin="28,5,0,0"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="SmartPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Smart Explorer"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_SmartDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_ModuleState], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Smart Explorer" VerticalAlignment="Center"/><ToggleButton x:Name="SmartExplorerModule" Grid.Column="1" Style="{StaticResource ModuleToggle}" IsChecked="{Binding SmartExplorerEnabled, Mode=OneWay}" Checked="ModuleChanged" Unchecked="ModuleChanged" AutomationProperties.Name="{Binding [Settings_EnableModule], Source={x:Static loc:Loc.Text}}"/></Grid></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Page_Behavior], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [Settings_SmartHotkey], Source={x:Static loc:Loc.Text}}"/><TextBlock Text="{Binding [Settings_SmartHotkeyHint], Source={x:Static loc:Loc.Text}}" Style="{StaticResource Hint}"/></StackPanel><Button x:Name="SmartHotkeyButton" Grid.Column="1" Content="{Binding SmartExplorerHotkey}" Click="CaptureSmartHotkey" PreviewKeyDown="SmartHotkeyKeyDown" LostKeyboardFocus="SmartHotkeyLostFocus" MinWidth="145" Padding="10,6"/></Grid>
                                    <Border Background="#3B3B3B" Height="1" Margin="0,14"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="SmartExplorerFallback" Content="{Binding [Module_SmartExplorerFallback], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding SmartExplorerUseLastPath, Mode=OneWay}" Checked="FallbackChanged" Unchecked="FallbackChanged"/><Border x:Name="SmartFallbackInfo" Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Hint_SmartFallback], Source={x:Static loc:Loc.Text}}" ToolTipService.Placement="Bottom"><TextBlock Text="ⓘ" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="DownloadsPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_Downloads], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_DownloadsDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_ModuleState], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding [Nav_Downloads], Source={x:Static loc:Loc.Text}}" VerticalAlignment="Center"/><ToggleButton x:Name="DownloadsModule" Grid.Column="1" Style="{StaticResource ModuleToggle}" IsChecked="{Binding DownloadsEnabled, Mode=OneWay}" Checked="ModuleChanged" Unchecked="ModuleChanged" AutomationProperties.Name="{Binding [Settings_EnableModule], Source={x:Static loc:Loc.Text}}"/></Grid></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Heading], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <ListBox x:Name="FolderList" MaxHeight="190" ItemsSource="{Binding Sources}" AutomationProperties.Name="{Binding [Settings_ListName], Source={x:Static loc:Loc.Text}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Visibility="{Binding ShowStatus, Converter={StaticResource BooleanVisibility}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel x:Name="Actions" Margin="-3,9,-3,0">
                                        <Button Content="{Binding [Settings_AddFolder], Source={x:Static loc:Loc.Text}}" Click="AddFolder"/>
                                        <Button Content="{Binding [Settings_AddDownloads], Source={x:Static loc:Loc.Text}}" Click="AddDownloads" Visibility="{Binding CanAddDownloads, Converter={StaticResource BooleanVisibility}}"/>
                                        <Button x:Name="RemoveButton" Content="{Binding [Settings_Remove], Source={x:Static loc:Loc.Text}}" Click="RemoveFolder" IsEnabled="False"/>
                                        <Button Content="{Binding [Settings_Retry], Source={x:Static loc:Loc.Text}}" Click="Retry" Visibility="{Binding HasUnavailable, Converter={StaticResource BooleanVisibility}}"/>
                                    </WrapPanel>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Sort], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SortBox" ItemsSource="{Binding SortOptions}" SelectedValuePath="Field" SelectedValue="{Binding SortBy, Mode=OneWay}" SelectionChanged="SortFieldChanged" AutomationProperties.Name="{Binding [Settings_Sort], Source={x:Static loc:Loc.Text}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"><CheckBox x:Name="SortReverse" Content="{Binding [Settings_SortReverse], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding SortReversed, Mode=OneWay}" Checked="SortReverseChanged" Unchecked="SortReverseChanged"/><Border Style="{StaticResource InfoGlyph}" ToolTip="{Binding [Hint_ReverseSort], Source={x:Static loc:Loc.Text}}" ToolTipService.Placement="Bottom"><TextBlock Text="ⓘ" Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_SortHint], Source={x:Static loc:Loc.Text}}"/>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Appearance], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Settings_Count], Source={x:Static loc:Loc.Text}}" VerticalAlignment="Center"/>
                                        <Slider x:Name="VisibleCount" Grid.Column="1" Margin="15,0,10,0" Minimum="1" Maximum="20" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxVisibleItems, Mode=OneWay}" ValueChanged="VisibleCountChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=VisibleCount, StringFormat={}{0:0}}" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_CountHint], Source={x:Static loc:Loc.Text}}"/>
                                    <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Settings_Backdrop], Source={x:Static loc:Loc.Text}}" VerticalAlignment="Center"/>
                                        <Slider x:Name="Backdrop" Grid.Column="1" Margin="15,0,10,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding BackdropOpacity, Mode=OneWay}" ValueChanged="BackdropChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Backdrop, StringFormat={}{0:0}%}" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_BackdropHint], Source={x:Static loc:Loc.Text}}"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_About], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_AboutDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Nav_Application], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock x:Name="AboutVersion" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}"/>
                                    <WrapPanel Margin="-3,12,-3,0">
                                        <Button x:Name="CheckUpdatesButton" Content="{Binding [Settings_CheckUpdates], Source={x:Static loc:Loc.Text}}" Click="CheckUpdates"/>
                                        <Button x:Name="InstallUpdateButton" Content="{Binding [Settings_InstallUpdate], Source={x:Static loc:Loc.Text}}" Click="InstallUpdate" Visibility="Collapsed"/>
                                    </WrapPanel>
                                </StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="30,0,30,8">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FF99A4" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}"/>
                        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#FF99A4"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#222222" BorderBrush="#3B3B3B" BorderThickness="0,1,0,0">
                <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="AA Desk" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="FooterUpdateButton" Grid.Column="2" Style="{StaticResource FooterLink}" FontSize="11" Click="FooterUpdate" MouseEnter="FooterUpdateEnter" MouseLeave="FooterUpdateLeave" Content="{Binding [Settings_CheckUpdates], Source={x:Static loc:Loc.Text}}"/>
                    <Ellipse Grid.Column="3" Width="6" Height="6" Fill="#58C7E8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateVersion" Grid.Column="4" Foreground="#9DCFE0" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
