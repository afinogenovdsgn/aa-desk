<Window x:Class="DownloadsStack.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DownloadsStack.Localization" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AA Desk" Style="{StaticResource {x:Type Window}}" Width="900" Height="650" MinWidth="760" MinHeight="520"
        Background="#242424" Foreground="{StaticResource TextBrush}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
        <SolidColorBrush x:Key="NavSelectedBrush" Color="#164657"/>
        <SolidColorBrush x:Key="NavNormalBrush" Color="Transparent"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#E7E7E7"/>
            <Setter Property="Padding" Value="11,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#343434"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="PageDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#8CA7B2"/><Setter Property="Margin" Value="0,17,0,8"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#282828"/><Setter Property="BorderBrush" Value="#3B3B3B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#A9A9A9"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    </Window.Resources>
    <Border BorderBrush="#414141" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#303030" BorderBrush="#3B3B3B" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <Image Source="Assets/app.ico" Width="16" Height="16" Margin="12,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="AA Desk" VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="2" Content="×" FontSize="17" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" Click="Done" shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="{Binding [Settings_Close], Source={x:Static loc:Loc.Text}}"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="#202020" BorderBrush="#3B3B3B" BorderThickness="0,0,1,0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="35"/></Grid.RowDefinitions>
                        <Border BorderBrush="#3B3B3B" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="Assets/app.ico" Width="28" Height="28" Margin="0,0,9,0"/>
                                <TextBlock Text="AA Desk" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="8,8,8,0">
                            <TextBlock Text="{Binding [Settings_Modules], Source={x:Static loc:Loc.Text}}" FontSize="10" Foreground="#8D8D8D" Margin="10,4,0,5"/>
                            <Button x:Name="GeneralNav" Style="{StaticResource NavButton}" Background="{StaticResource NavSelectedBrush}" Click="NavigateGeneral" Content="{Binding [Nav_General], Source={x:Static loc:Loc.Text}}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="SmartNav" Grid.Column="0" Style="{StaticResource NavButton}" Click="NavigateSmart" Content="Smart Explorer"/>
                                <CheckBox x:Name="SmartExplorerModule" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="{Binding SmartExplorerEnabled, Mode=OneWay}" Checked="ModuleChanged" Unchecked="ModuleChanged" AutomationProperties.Name="{Binding [Module_SmartExplorer], Source={x:Static loc:Loc.Text}}"/>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="DownloadsNav" Grid.Column="0" Style="{StaticResource NavButton}" Click="NavigateDownloads" Content="{Binding [Nav_Downloads], Source={x:Static loc:Loc.Text}}"/>
                                <CheckBox x:Name="DownloadsModule" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="{Binding DownloadsEnabled, Mode=OneWay}" Checked="ModuleChanged" Unchecked="ModuleChanged" AutomationProperties.Name="{Binding [Module_Downloads], Source={x:Static loc:Loc.Text}}"/>
                            </Grid>
                            <Border Background="#3B3B3B" Height="1" Margin="5,12,5,9"/>
                            <TextBlock Text="{Binding [Nav_Application], Source={x:Static loc:Loc.Text}}" FontSize="10" Foreground="#8D8D8D" Margin="10,0,0,5"/>
                            <Button x:Name="AboutNav" Style="{StaticResource NavButton}" Click="NavigateAbout" Content="{Binding [Nav_About], Source={x:Static loc:Loc.Text}}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="AA Desk" Foreground="#888888" FontSize="11" Margin="16,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="35"/></Grid.RowDefinitions>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="30,24,30,24">
                            <StackPanel x:Name="GeneralPage">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_General], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_GeneralDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Startup], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <CheckBox x:Name="RunAtLogon" Content="{Binding [Settings_RunAtLogon], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding RunAtLogon, Mode=OneWay}" Checked="RunAtLogonChanged" Unchecked="RunAtLogonChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_RunAtLogonHint], Source={x:Static loc:Loc.Text}}" Margin="28,5,0,0"/>
                                    <TextBlock x:Name="StartupBlocked" Style="{StaticResource Hint}" Foreground="#FF99A4" Text="{Binding [Settings_RunAtLogonBlocked], Source={x:Static loc:Loc.Text}}" Visibility="{Binding AutostartBlocked, Converter={StaticResource BooleanVisibility}}" Margin="28,5,0,0"/>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Appearance], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <CheckBox x:Name="Hardware" Content="{Binding [Settings_Hardware], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding HardwareRendering, Mode=OneWay}" Checked="HardwareChanged" Unchecked="HardwareChanged"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_HardwareHint], Source={x:Static loc:Loc.Text}}" Margin="28,5,0,0"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="SmartPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Smart Explorer"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_SmartDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Page_Behavior], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="{Binding [Module_SmartExplorerHotkey], Source={x:Static loc:Loc.Text}}" TextWrapping="Wrap"/>
                                    <Border Background="#3B3B3B" Height="1" Margin="0,14"/>
                                    <CheckBox x:Name="SmartExplorerFallback" Content="{Binding [Module_SmartExplorerFallback], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding SmartExplorerUseLastPath, Mode=OneWay}" Checked="FallbackChanged" Unchecked="FallbackChanged"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="DownloadsPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_Downloads], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_DownloadsDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Heading], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <ListBox x:Name="FolderList" MaxHeight="190" ItemsSource="{Binding Sources}" AutomationProperties.Name="{Binding [Settings_ListName], Source={x:Static loc:Loc.Text}}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Visibility="{Binding ShowStatus, Converter={StaticResource BooleanVisibility}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <WrapPanel x:Name="Actions" Margin="-3,9,-3,0">
                                        <Button Content="{Binding [Settings_AddFolder], Source={x:Static loc:Loc.Text}}" Click="AddFolder"/>
                                        <Button Content="{Binding [Settings_AddDownloads], Source={x:Static loc:Loc.Text}}" Click="AddDownloads" Visibility="{Binding CanAddDownloads, Converter={StaticResource BooleanVisibility}}"/>
                                        <Button x:Name="RemoveButton" Content="{Binding [Settings_Remove], Source={x:Static loc:Loc.Text}}" Click="RemoveFolder" IsEnabled="False"/>
                                        <Button Content="{Binding [Settings_Retry], Source={x:Static loc:Loc.Text}}" Click="Retry" Visibility="{Binding HasUnavailable, Converter={StaticResource BooleanVisibility}}"/>
                                    </WrapPanel>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Sort], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SortBox" ItemsSource="{Binding SortOptions}" SelectedValuePath="Field" SelectedValue="{Binding SortBy, Mode=OneWay}" SelectionChanged="SortFieldChanged" AutomationProperties.Name="{Binding [Settings_Sort], Source={x:Static loc:Loc.Text}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                        <CheckBox x:Name="SortReverse" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Content="{Binding [Settings_SortReverse], Source={x:Static loc:Loc.Text}}" IsChecked="{Binding SortReversed, Mode=OneWay}" Checked="SortReverseChanged" Unchecked="SortReverseChanged"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_SortHint], Source={x:Static loc:Loc.Text}}"/>
                                </StackPanel></Border>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Settings_Appearance], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Settings_Count], Source={x:Static loc:Loc.Text}}" VerticalAlignment="Center"/>
                                        <Slider x:Name="VisibleCount" Grid.Column="1" Margin="15,0,10,0" Minimum="1" Maximum="20" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxVisibleItems, Mode=OneWay}" ValueChanged="VisibleCountChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=VisibleCount, StringFormat={}{0:0}}" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_CountHint], Source={x:Static loc:Loc.Text}}"/>
                                    <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [Settings_Backdrop], Source={x:Static loc:Loc.Text}}" VerticalAlignment="Center"/>
                                        <Slider x:Name="Backdrop" Grid.Column="1" Margin="15,0,10,0" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding BackdropOpacity, Mode=OneWay}" ValueChanged="BackdropChanged"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Backdrop, StringFormat={}{0:0}%}" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding [Settings_BackdropHint], Source={x:Static loc:Loc.Text}}"/>
                                </StackPanel></Border>
                            </StackPanel>
                            <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding [Nav_About], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource PageDescription}" Text="{Binding [Page_AboutDesc], Source={x:Static loc:Loc.Text}}"/>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="{Binding [Nav_Application], Source={x:Static loc:Loc.Text}}"/>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock x:Name="AboutVersion" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Hint}"/>
                                    <WrapPanel Margin="-3,12,-3,0">
                                        <Button x:Name="CheckUpdatesButton" Content="{Binding [Settings_CheckUpdates], Source={x:Static loc:Loc.Text}}" Click="CheckUpdates"/>
                                        <Button x:Name="InstallUpdateButton" Content="{Binding [Settings_InstallUpdate], Source={x:Static loc:Loc.Text}}" Click="InstallUpdate" Visibility="Collapsed"/>
                                    </WrapPanel>
                                </StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="30,0,30,8">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#FF99A4" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}"/>
                        <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#FF99A4"/>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#222222" BorderBrush="#3B3B3B" BorderThickness="0,1,0,0">
                        <Grid Margin="13,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="●  AA Desk" Foreground="#83C9E2" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="FooterUpdateButton" Grid.Column="2" Style="{StaticResource NavButton}" Foreground="#83C9E2" Padding="4,2" Click="FooterUpdate" Content="{Binding [Settings_CheckUpdates], Source={x:Static loc:Loc.Text}}"/>
                            <TextBlock x:Name="UpdateVersion" Grid.Column="3" Foreground="#888888" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
